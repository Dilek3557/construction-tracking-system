# Kopyalayın:  cp .env.example .env
#
# Backend’e doğrudan bağlanmak (tarayıcı CORS’a tabi — backend ALLOWED_ORIGINS’te bu origin olmalı)
VITE_API_BASE_URL=http://localhost:8080
#
# Vite proxy kullanmak isterseniz: satırı silin/yorum yapın → istekler /projects gibi relative gider,
# vite.config.js proxy’si localhost:8080’e yollar (çoğu durumda CORS gerekmez).
#
# Backend’i farklı portta çalıştırıyorsanız sadece dev proxy hedefini değiştirmek için:
# VITE_DEV_PROXY_TARGET=http://localhost:9090
